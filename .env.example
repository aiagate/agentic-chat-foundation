# Discord Bot Token
DISCORD_BOT_TOKEN=

#LINE Messaging API Key
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Database URL
DATABASE_URL=sqlite+aiosqlite:///./bot.db

# Event bus provider for multi-process operation
# EVENT_BUS_PROVIDER=redis
# REDIS_URL=redis://localhost:6379/0
# EVENT_CONSUMER_GROUP=worker

# Google Gemini API Key
GEMINI_API_KEY=

# OpenAI API Key
OPENAI_API_KEY=

# Local long-term memory root
# MEMORY_ROOT is preferred. MEMORY_AGENT_ROOT is kept only for legacy fallback.
MEMORY_ROOT=memory
# MEMORY_AGENT_ROOT=memory

# Active built-in character identifier.
# Override this to match the memory/profile bundle mounted into the container.
ACTIVE_CHARACTER_ID=shirasagi-reina

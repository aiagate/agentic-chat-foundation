# Discord Bot Token
DISCORD_BOT_TOKEN=

# Comma-separated Discord text channel or thread IDs observed for autonomous
# discussion. DMs continue to use the existing one-to-one response flow.
DISCORD_DISCUSSION_CHANNEL_IDS=
DISCORD_DISCUSSION_BACKFILL_LIMIT=50
DISCORD_RESPONSE_DELAY_MIN_SECONDS=2
DISCORD_RESPONSE_DELAY_MAX_SECONDS=8

# Local publication guards. Every observed message is still evaluated by the
# LLM; these values only control whether a proposed public response is sent.
DISCORD_MAX_CONSECUTIVE_BOT_MESSAGES=8
DISCORD_SPEAK_COOLDOWN_SECONDS=20
DISCORD_RATE_WINDOW_SECONDS=300
DISCORD_MAX_PUBLISHED_TURNS_PER_WINDOW=5

# Internally generated topics. Internet-backed stimuli are intentionally not
# fetched yet; the evaluator receives an empty stimuli array for future use.
DISCORD_AUTONOMOUS_TOPICS_ENABLED=false
DISCORD_AUTONOMOUS_TOPIC_INITIAL_DELAY_SECONDS=300
DISCORD_AUTONOMOUS_TOPIC_INTERVAL_SECONDS=900
DISCORD_AUTONOMOUS_TOPIC_IDLE_SECONDS=1800
DISCORD_AUTONOMOUS_TOPIC_EVALUATION_COOLDOWN_SECONDS=900
DISCORD_AUTONOMOUS_TOPIC_RATE_WINDOW_SECONDS=86400
DISCORD_AUTONOMOUS_TOPIC_MAX_PUBLISHED_PER_WINDOW=3

#LINE Messaging API Key
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Database URL
DATABASE_URL=sqlite+aiosqlite:///./bot.db
# Enable verbose SQL statement logging only for local diagnosis.
SQLALCHEMY_ECHO=false

# Google Gemini API Key
GEMINI_API_KEY=
# Gemini embedding model used for memory indexing
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# OpenAI API Key
OPENAI_API_KEY=
# OpenAI model used when AI_PROVIDER=openai
OPENAI_MODEL=gpt-5.6-terra
# OpenAI reasoning and response style for direct chat replies
OPENAI_REASONING_EFFORT=low
OPENAI_TEXT_VERBOSITY=low
OPENAI_MAX_OUTPUT_TOKENS=1024

# Local long-term memory root
MEMORY_ROOT=memory

# Active built-in character identifier.
# Override this to match the memory/profile bundle mounted into the container.
ACTIVE_CHARACTER_ID=shirasagi-reina

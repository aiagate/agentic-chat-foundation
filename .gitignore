# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyre/
.pytype/
.hypothesis/
.ipynb_checkpoints/

# Local Python environments and package build output
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.uv-cache/
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
*.egg-info/
*.egg
*.whl
pip-wheel-metadata/

# Test and coverage output
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
nosetests.xml
*.cover
*.py,cover

# Local configuration and credentials.
# Keep only shareable templates and the Docker defaults tracked.
.env*
!.env.example
!.env.docker
!.env.cloudflared.example

# Local databases, logs, and runtime output
*.db
*.sqlite
*.sqlite3
*.sqlite-*
*.db-*
*.log
.run-logs/

# Runtime memory. Agent profiles are immutable application configuration and
# are included in the image; all user and generated memory stays local.
/memory/*
!/memory/profiles/
!/memory/profiles/agent/
!/memory/profiles/agent/**
/memory/profiles/users/
/memory/timeline/
/memory/entities/

# Documentation and static-site build output
docs/_build/
site/

# Editor, OS, and temporary files
.DS_Store
Thumbs.db
*.swp
*.swo
*.tmp
*.bak
*.orig

# Local tooling state
.claude/settings.local.json
.idea/
